# Copy this file to .env before starting Compose.

# The frontend uses the same-origin Nginx API proxy in Docker.
VITE_API_BASE_URL=/api
VITE_BUILDING_DT_API_BASE_URL=/api/building-dt/components
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://SERVER_HOST:3000
# Shared only by Spring and the private Python maintenance endpoint.
COZYBENCH_MAINTENANCE_TOKEN=replace-with-a-long-random-value
