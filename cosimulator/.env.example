# Copy this file to .env and replace the secret before starting Compose.
JWT_SECRET=replace-this-with-a-long-random-secret

# The frontend uses the same-origin Nginx API proxy in Docker.
VITE_API_BASE_URL=/api
VITE_BUILDING_DT_API_BASE_URL=/api/building-dt/components
CORS_ALLOWED_ORIGINS=http://localhost:3000
